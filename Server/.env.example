PORT=5000
NODE_ENV=development
# Exact trusted frontend origin, including scheme and port (no path).
# Authentication POST requests must send this Origin and X-CoCreate-Request: 1.
CLIENT_URL=http://localhost:3000

MONGODB_URI=
REDIS_URL=


JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_TTL_SECONDS=604800
REFRESH_COOKIE_MAX_AGE_MS=604800000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

YOUTUBE_API_KEY=
